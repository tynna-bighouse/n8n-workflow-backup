    {
      "parameters": {
        "jsCode": "let raw = $json.text ?? \"\";\n\n// 去掉可能的 ``` 包裹（以防万一）\nraw = raw.trim();\nraw = raw.replace(/^```json/i, \"\");\nraw = raw.replace(/^```/, \"\");\nraw = raw.replace(/```$/, \"\");\nraw = raw.trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // 解析失败，直接返回原始文本和错误信息，方便排查\n  return [\n    {\n      json: {\n        raw_text: raw,\n        parse_error: e.message,\n      },\n    },\n  ];\n}\n\n// 期望结构：一个数组，每个元素是一条需求记录\n// [ { demand, customer, status, quantity, country, channel, priority, note }, ... ]\nif (!Array.isArray(parsed)) {\n  // 如果模型没按要求返回，就把整个对象放进一条记录\n  return [\n    {\n      json: parsed,\n    },\n  ];\n}\n\n// 把每条记录变成 n8n 的一行\nreturn parsed.map((item) => ({\n  json: {\n    // 这里的字段名可以对应你在表格里的实际列名\n    demand: item.demand ?? \"\",\n    customer: item.customer ?? \"\",\n    status: item.status ?? \"\",\n    quantity: item.quantity ?? null,\n    country: item.country ?? \"\",\n    channel: item.channel ?? \"\",\n    priority: item.priority ?? \"normal\",\n    note: item.note ?? \"\",\n  },\n}));"
      },
