        "jsCode": "// 从 URL 中提取 detail_id（视频ID）\nconst response = $input.first().json;\nconst url = response.url || response.data?.url || '';\n\n// 从 URL 中提取数字 ID\nconst match = url.match(/\\/video\\/(\\d+)/);\nconst detailId = match ? match[1] : null;\n\nif (!detailId) {\n  throw new Error('无法从 URL 中提取 detail_id: ' + url);\n}\n\nreturn [{\n  json: {\n    detail_id: detailId,\n    original_url: url\n  }\n}];"
      },
