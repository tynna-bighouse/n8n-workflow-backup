      "parameters": {
        "jsCode": "// 获取所有输入的数据\nconst items = $input.all();\n\nreturn items.map(item => {\n  \n  // 1. 先把图片提取出来，过滤掉空的\n  // 请将 item.json.images2 换成你实际的第二列列名\n  const rawImages = [item.json.images, item.json.images2];\n  // 这一步会把 undefined, null, 或空字符串 \"\" 踢掉\n  const validImages = rawImages.filter(img => img && img.trim() !== \"\");\n\n  return {\n    json: {\n      prompt: item.json.prompt,\n      \n      // 2. 使用处理好的图片数组\n      images: validImages, \n      \n      orientation: \"portrait\",\n      duration: 15,\n      size: \"large\",\n      model: \"sora-2\",\n      watermark: false\n    }\n  };\n});"
      },
