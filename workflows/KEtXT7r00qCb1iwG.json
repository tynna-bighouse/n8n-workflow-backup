    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  // 1. 从 data.url 里取图片地址\n  const url = item.json?.data?.url;\n\n  // 2. 过滤：如果没有 url，就用空数组\n  const validImages = url && String(url).trim() !== \"\" ? [url] : [];\n\n  // 3. 构造请求 body\n  const body = {\n    model: \"gpt-5.1\",\n    stream: false,\n    messages: [\n      {\n        role: \"user\",\n        content: [\n          {\n            type: \"text\",\n            text: item.json.prompt || \"\",\n          },\n          // 把图片数组转成 image_url 块\n          ...validImages.map(u => ({\n            type: \"image_url\",\n            image_url: { url: u },\n          })),\n        ],\n      },\n    ],\n    max_tokens: 400,\n  };\n\n  return { json: body };\n});"
      },
