    {
      "parameters": {
        "jsCode": "let raw = $json.text ?? \"\";\n\n// 去掉可能的 ``` 包裹（以防万一）\nraw = raw.trim();\nraw = raw.replace(/^```json/i, \"\");\nraw = raw.replace(/^```/, \"\");\nraw = raw.replace(/```$/, \"\");\nraw = raw.trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  return [{ json: { raw_text: raw, parse_error: e.message } }];\n}\n\n// 期望结构：{ items: [ {...}, {...} ] }\nif (!parsed.items || !Array.isArray(parsed.items)) {\n  // 如果模型没按要求返回，就把整个对象放进一条记录\n  return [{ json: parsed }];\n}\n\n// 把每个 item 变成 n8n 的一行\nreturn parsed.items.map(item => ({\n  json: {\n    item_description: item.item_description ?? \"\",\n    product_name: item.product_name ?? \"\",\n    unit_price_usd: item.unit_price_usd ?? null,\n    quantity_moq: item.quantity_moq ?? null,\n  },\n}));"
      },
